# Keycloak Server Configuration
KEYCLOAK_SERVER_URL=http://localhost:8080/
KEYCLOAK_REALM=notes-app
KEYCLOAK_CLIENT_ID=notes-client
KEYCLOAK_CLIENT_SECRET=notes-client-secret

# Keycloak Admin Credentials (used by setup_keycloak.py)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Flask Web Application Settings
FLASK_SECRET_KEY=super-secret-development-key-change-in-production
FLASK_PORT=5002
APP_URL=http://localhost:5002
